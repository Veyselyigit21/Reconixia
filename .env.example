# Reconixia configuration example
# Kullanım:
# cp .env.example .env
# nano .env
#
# Sadece kullanacağın sağlayıcıları doldur.
# Gerçek .env dosyanı GitHub'a yükleme.

RECONIXIA_AI_PROVIDER=local

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1

# OpenAI / ChatGPT API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner

# Future remote worker support
DIGITALOCEAN_TOKEN=
HETZNER_TOKEN=
